{"css":"\n.p12-page { display: grid; grid-template-rows: auto 1fr; min-height: 100cqh; overflow-x: clip; }\n.p12-page > .deck, .p12-page > .p12-center { grid-row: 2; align-self: center; }\n.p12-top { display: grid; gap: var(--s-2); width: 100%; max-width: 56rem; margin-inline: auto; padding: var(--s-3) var(--s-3) 0; grid-row: 1; }\n.p12-top:empty { display: none; }\n.p12-strip { --p12-strip-h: 9.5rem; }\n.p12-strip .deck { --card: max(var(--card-min), min(var(--card-max), calc(100cqw - 2rem), calc(100cqh - 2rem - var(--peek) - var(--s-3) - var(--controls-h) - var(--p12-strip-h)))); }\n@media not all and (min-width: 48rem) and (min-height: 31.25rem) { .p12-strip { --p12-strip-h: 19.5rem; } }\n@media (max-width: 21.25rem) { .p12-strip { --p12-strip-h: 29.5rem; } }\n.p12-scrolled .p12-page { margin-top: -5.25rem; }\n.p12-e { --frame-w: var(--w2); }\n.p12-focus { border-color: var(--blue); outline: var(--w1) solid var(--blue); outline-offset: calc(var(--w1) * -2); }\n.p12-w { position: relative; display: inline-grid; }\n.p12-tipw { position: relative; display: inline-flex; }\n.p12-tip-up { position: absolute; z-index: 30; bottom: calc(100% + var(--s-1)); left: 50%; translate: -50% 0; width: max-content; max-width: min(17.5rem, 80vw); text-align: center; }\n@media not all and (min-width: 48rem) and (min-height: 31.25rem) {\n  .p12-tip-up.p12-tip-start { left: 0; translate: 0 0; text-align: start; }\n  .p12-tip-up.p12-tip-end { left: auto; right: 0; translate: 0 0; text-align: end; }\n}\n.p12-tip-dn { position: absolute; z-index: 30; top: calc(100% + var(--s-1)); right: 0; width: max-content; max-width: min(17.5rem, 80vw); }\n.btn .spinner, .banner .spinner { width: var(--icon-sm); height: var(--icon-sm); }\n\n.deck-card__foot.p-solo > :first-child { justify-self: center; }\n\n.p12-pop .menu { width: max-content; min-width: 8.75rem; max-width: calc(var(--card) - 1rem); z-index: 20; }\n.p12-pop .menu__item { justify-content: flex-start; }\n.p12-hov { text-decoration: underline; text-underline-offset: 0.25em; }\n.p12-scroll { border-bottom: var(--w1) solid var(--rule); scrollbar-width: thin; scrollbar-color: var(--line) transparent; }\n.deck-card__head .menu-pop { flex: none; }\n\n@media (max-width: 21.25rem) {\n  .composer { gap: var(--s-1); padding-inline: var(--s-1); }\n  .composer .input { padding-inline: var(--s-1); }\n  .composer .input::placeholder { font-size: var(--fs-small); }\n}\n\n\n.deck-card__head:has(> .p12-tipw .p12-tip-dn) { flex-wrap: wrap; }\n.deck-card__head > .p12-tipw { display: contents; }\n.p12-tipw .p12-tip-dn { position: static; order: 3; margin-inline-start: auto; width: auto; max-width: 100%; }\n\n.p12-tipw .p12-tip-hover { position: absolute; z-index: 30; bottom: calc(100% + var(--s-1)); right: 0; width: max-content; max-width: min(17.5rem, 80vw); }\n.deck-card__head > .p12-tipw--hover { display: inline-flex; position: relative; }\n\n.deck-card:has(.deck-card__foot > .flag) .deck-card__face--front .deck-card__text.p12-scroll { flex: none; margin-bottom: 0; --p12-tl: 3; height: max(1lh, calc(var(--card) * 0.56 - var(--pad) - var(--p12-tl) * var(--lh-h1) - var(--s-1) - 2 * var(--s-2))); }   \n@supports (height: round(down, 1px, 1px)) { .deck-card:has(.deck-card__foot > .flag) .deck-card__face--front .deck-card__text.p12-scroll { height: max(1lh, round(down, calc(var(--card) * 0.56 - var(--pad) - var(--p12-tl) * var(--lh-h1) - var(--s-1) - 2 * var(--s-2)), 1lh)); } }\n@container card (max-width: 18.74rem) {\n  .deck-card:has(.deck-card__foot > .flag) .deck-card__face--front .deck-card__text.p12-scroll { --p12-tl: 2; height: max(1lh, calc(var(--card) * 0.5 - var(--pad) - var(--p12-tl) * var(--lh-h1) - var(--s-1) - 2 * var(--s-2))); }   \n  @supports (height: round(down, 1px, 1px)) { .deck-card:has(.deck-card__foot > .flag) .deck-card__face--front .deck-card__text.p12-scroll { height: max(1lh, round(down, calc(var(--card) * 0.5 - var(--pad) - var(--p12-tl) * var(--lh-h1) - var(--s-1) - 2 * var(--s-2)), 1lh)); }