{"css":"\n:root { --p05b-col: 52rem; --p05b-area-min: clamp(8rem, 38cqh, 18rem); --p05b-room: 2rem; --p05b-combo-room: 3.25rem; --p05b-tab-end: 1.5rem; --p05b-menu-min: 10rem; --p05b-menu-rest: 7rem; }\n.p05b-wrap { max-width: var(--p05b-col); margin-inline: auto; display: grid; gap: var(--s-3); margin-top: calc(var(--p05b-scroll, 0rem) * -1); }\n.p05b-top { display: grid; gap: var(--s-2); }\n.p05b-form { display: grid; gap: var(--s-4); }\n.p05b-form .field__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: flex-start; column-gap: var(--s-2); }\n.p05b-pos { position: relative; }\n.p05b-ph { color: var(--muted); }\n.p05b-form .select[aria-invalid=\"true\"] { border-color: var(--terra); outline: var(--w1) solid var(--terra); outline-offset: calc(var(--w1) * -2); }\n.p05b-form .select.p05b-focus { border-color: var(--blue); outline: var(--w1) solid var(--blue); outline-offset: calc(var(--w1) * -2); }\n.p05b-combo { position: relative; }\n.p05b-combo .textarea { padding-inline-end: var(--p05b-combo-room); }\n.p05b-combo__btn { position: absolute; inset-block-start: 0; inset-inline-end: var(--w2); }\n.p05b-name { min-height: var(--ctl-h); resize: none; field-sizing: content; }\n.p05b-area { position: relative; }\n.p05b-area .textarea { min-height: var(--p05b-area-min); resize: none; }\n.field__count.is-over { color: var(--ink); font-weight: var(--fw-bold); }\n.p05b-focus { border-color: var(--blue); outline: var(--w1) solid var(--blue); outline-offset: calc(var(--w1) * -2); }\n.p05b-e { --frame-w: var(--w2); }\n.p05b-ro { display: grid; }\n.p05b-rolabel { margin: 0 0 var(--s-1); }\n.p05b-more { padding-top: var(--s-1); }\n.p05b-kept { display: grid; gap: var(--s-1); width: 100%; }\n.p05b-kept p { margin: 0; }\n.p05b-keptbox { display: grid; gap: var(--s-1); padding: var(--s-2) var(--s-3); user-select: text; font-size: var(--fs-small); line-height: var(--lh-small); overflow-wrap: anywhere; }\n.rec.p05b-roc { grid-template-columns: minmax(0, 1f