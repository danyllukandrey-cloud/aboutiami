{"css":"\n.p11-page { display: grid; grid-template-rows: auto 1fr; min-height: 100cqh; overflow-x: clip; }\n.p11-page > .deck, .p11-page > .p11-center { grid-row: 2; align-self: center; }\n.p11-top { display: grid; gap: var(--s-2); width: 100%; max-width: 56rem; margin-inline: auto; padding: var(--s-3) var(--s-3) 0; grid-row: 1; }\n.p11-top:empty { display: none; }\n.p11-strip { --p11-strip-h: 9.5rem; }\n.p11-strip .deck { --card: max(var(--card-min), min(var(--card-max), calc(100cqw - 2rem), calc(100cqh - 2rem - var(--peek) - var(--s-3) - var(--controls-h) - var(--p11-strip-h)))); }\n@media not all and (min-width: 48rem) and (min-height: 31.25rem) { .p11-strip { --p11-strip-h: 19.5rem; } }\n@media (max-width: 21.25rem) { .p11-strip { --p11-strip-h: 29.5rem; } }\n.p11-scrolled .p11-page { margin-top: -5.25rem; }\n.p11-e { --frame-w: var(--w2); }\n.p11-focus { border-color: var(--blue); outline: var(--w1) solid var(--blue); outline-offset: calc(var(--w1) * -2); }\n.p11-w { position: relative; display: inline-grid; }\n.p11-tipw { position: relative; display: inline-flex; }\n.p11-tip-up { position: absolute; z-index: 30; bottom: calc(100% + var(--s-1)); left: 50%; translate: -50% 0; width: max-content; max-width: min(17.5rem, 80vw); text-align: center; }\n@media not all and (min-width: 48rem) and (min-height: 31.25rem) {\n  .p11-tip-up.p11-tip-start { left: 0; translate: 0 0; text-align: start; }\n  .p11-tip-up.p11-tip-end { left: auto; right: 0; translate: 0 0; text-align: end; }\n}\n.p11-tip-dn { position: absolute; z-index: 30; top: calc(100% + var(--s-1)); right: 0; width: max-content; max-width: min(17.5rem, 80vw); }\n.btn .spinner, .banner .spinner { width: var(--icon-sm); height: var(--icon-sm); }\n.p11-tip-ask { position: absolute; z-index: 30; top: 100%; left: 0; width: max-content; max-width: min(17.5rem, 70vw); }\n\n.deck-card__foot.p-solo > :first-child { justify-self: center; }\n.p-state { display: flex; align-items: center; min-height: 1.5rem; margin-top: calc(var(--s-1) * -1); }\n.p-ask { display: inline-grid; place-items: center; min-width: var(--hit); min-height: var(--hit); margin-inline-start: calc(var(--s-2) * -1); padding: 0; border: var(--w1) solid transparent; border-radius: var(--r); background: transparent; color: var(--ink); cursor: pointer; }\n.p-dashring { width: 0.625rem; height: 0.625rem; border: 1.5px dashed var(--muted); border-radius: 50%; }\n.p-state--ask { position: relative; }\n\n.p11-face { gap: var(--s-3); }\n.p11-win .deck-card__head { margin-top: 0; }\n.p11-body { flex: 1 1 auto; min-height: 0; overflow: auto; display: grid; gap: var(--s-4); align-content: start; font-size: var(--fs-small); line-height: var(--lh-small); padding-block: var(--s-1); border-bottom: var(--w1) solid var(--rule); }\n.p11-foot { flex: none; display: flex; gap: var(--s-2); justify-content: space-between; }\n.p11-foot > * { flex: 1 1 0; }\n.p11-foot--one { justify-content: center; }\n.p11-foot--one > * { flex: 0 1 auto; min-width: 9rem; }\n\n.p11-pressed { border-width: var(--w2); border-color: var(--ink); text-decoration: underline; text-underline-offset: 0.25em; }\n.p11-fade { opacity: 0.5; }\n.p11-kind { display: grid; gap: var(--s-2); }\n\n@media (max-width: 21.25rem) {\n  .composer { gap: var(--s-1); padding-inline: var(--s-1); }\n  .composer .input { padding-inline: var(--s-1); }\n  .composer .input::placeholder { font-size: var(--fs-small); }\n}\n\n.deck__stack:has(> .p11-win) { width: min(var(--card-max), calc(100cqw - 2rem)); height: auto; }\n.deck__stack:has(> .p11-win) ~ .deck__controls { display: none; }\n.p11-win { position: relative; left: auto; bottom: auto; width: 100%; height: auto; min-height: var(--card-min); max-height: calc(100cqh - 2rem - var(--p11-win-off, 0rem)); display: flex; flex-direction: column; }\n.p11-win .deck-card__face { position: relative; inset: auto; flex: 1 1 auto; min-height: 0; }\n.p11-win [class*=\"-body\"], .p11-win .deck-card__scroll { scrollbar-width: thin; scrollbar-color: var(--line) var(--white); }\n.p11-strip { --p11-win-off: 9.5rem; }\n@media not all and (min-width: 48rem) and (min-height: 31.25rem) { .p11-strip { --p11-win-off: 19.5rem; } }\n@media (max-width: 21.25rem) { .p11-strip { --p11-win-off: 29.5rem; } }\n.p11-strip.p11-strip--b { --p11-win-off: 5.5rem; }\n@media (max-width: 21.25rem) { .p11-strip.p11-strip--b { --p11-win-off: 8rem; } }\n","states":["<div class=\"app\"><header class=\"app__header header\"><a class=\"brand\" href=\"#\" aria-label=\"AboutIAmI\"><svg class=\"brand__mark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><use href=\"#i-logo\"/></svg><span class=\"t-brand\">AboutIAmI</span></a><div class=\"header__actions\"><button class=\"btn\" type=\"button\">Вийти</button><details class=\"menu-pop\"><summary class=\"ibtn ibtn--framed\" aria-label=\"Меню налаштувань\"><svg class=\"ico\" aria-hidden=\"true\"><use href=\"#i-gear\"/></svg></summary><div class=\"menu frame frame--msg\" role=\"menu\"><a class=\"menu__item\" role=\"menuitem\" href=\"#\">Налаштування правил</a><a class=\"menu__item\" role=\"menuitem\" href=\"#\">Обліковий запис і дані</a><a class=\"menu__item\" role=\"menuitem\" href=\"#\">Лог дій</a><a class=\"menu__item\" role=\"menuitem\" href=\"#\">Точки відновлення</a><a class=\"menu__item\" role=\"menuitem\" href=\"#\">Написати розробникам</a></div></details></div></header><main class=\"app__content\" id=\"p11-def-main\"><div class=\"p11-page\"><h1 class=\"sr-only\">Картки</h1><div class=\"p11-top\"></div><div class=\"deck\"><div class=\"deck__stack\"><section class=\"deck-card frame frame--card p11-win\" role=\"dialog\" aria-labelledby=\"p11-def-wt\"><div class=\"deck-card__face p11-face\"><header class=\"deck-card__head\"><h2 class=\"deck-card__title\" id=\"p11-def-wt\">Нова картка</h2></header><div class=\"p11-body\"><div class=\"p11-kind\"><button class=\"btn btn--block\" type=\"button\">Картка сфери життя</button><p>Картка сфери життя — важлива для тебе сфера: здоров’я, робота, сім’я…</p></d