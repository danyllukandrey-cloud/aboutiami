{"css":"\n.p16b-page { display: grid; grid-template-rows: auto 1fr; min-height: 100cqh; overflow-x: clip; }\n.p16b-page > .deck { grid-row: 2; align-self: center; }\n.p16b-top { display: grid; gap: var(--s-2); width: 100%; max-width: 56rem; margin-inline: auto; padding: var(--s-3) var(--s-3) 0; grid-row: 1; }\n.p16b-top:empty { display: none; }\n.p16b-strip { --p16b-sh: 9rem; }\n.p16b-strip--b { --p16b-sh: 4.5rem; }\n.p16b-strip .deck { --card: max(var(--card-min), min(var(--card-max), calc(100cqw - 2rem), calc(100cqh - 2rem - var(--peek) - var(--s-3) - var(--controls-h) - var(--p16b-sh)))); }\n@media not all and (min-width: 48rem) and (min-height: 31.25rem) { .p16b-strip { --p16b-sh: 17rem; } .p16b-strip--b { --p16b-sh: 6rem; } }\n@media (max-width: 21.25rem) { .p16b-strip { --p16b-sh: 22rem; } .p16b-strip--b { --p16b-sh: 7rem; } }\n.p16b-win .deck-card__head { margin-top: 0; }\n.p16b-face { gap: var(--s-2); }\n.p16b-body { flex: 1 1 auto; min-height: 0; overflow: auto; display: grid; grid-auto-rows: min-content; gap: var(--s-3); align-content: start; padding-block: var(--s-1) var(--s-2); border-bottom: var(--w1) solid var(--rule); }\n.p16b-msg { flex: none; display: grid; gap: var(--s-2); }\n.p16b-msg:empty { display: none; }\n.p16b-foot { flex: none; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--s-2); }\n.dialog__foot.p16b-foot2 { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }\n.p16b-focus { border-color: var(--blue); outline: var(--w1) solid var(--blue); outline-offset: calc(var(--w1) * -1); }\n.p16b-area { position: relative; }\n.p16b-count { position: absolute; right: var(--s-2); bottom: var(--s-1); font-size: var(--fs-cap); line-height: var(--lh-cap); color: var(--muted); pointer-events: none; background: var(--white); padding-inline: var(--s-1); }\n.p16b-count.is-over { color: var(--ink); font-weight: var(--fw-bold); }\n.textarea.p16b-ta { min-height: 4rem; padding-bottom: 1.375rem; resize: none; }\n.p16b-pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: var(--s-3); align-items: start; }\n.p16b-pair .field { grid-template-columns: minmax(0, 1fr); }\n.p16b-pair .select { height: auto; min-width: 0; padding-block: var(--s-2); }\n.p16b-pair .select > span { min-width: 0; flex: 1 1 auto; overflow: hidden; overflow-wrap: anywhere; }\n.p16b-pair .select .motive { display: flex; max-width: 100%; }\n.p16b-pair + .menu { margin-top: calc(var(--s-2) * -1); }\n.p16b-full { grid-column: 1 / -1; }\n.textarea.p16b-name { min-height: var(--ctl-h); padding: var(--s-2) var(--s-3); resize: none; overflow-wrap: anywhere; }\n.btn .spinner { width: var(--icon-sm); height: var(--icon-sm); }\n.p16b-tipw { position: relative; display: flex; min-width: 0; }\n.p16b-tipw > .btn { flex: 1 1 auto; width: 100%; }\n.p16b-tip { position: absolute; z-index: 30; bottom: calc(100% + var(--s-1)); right: 0; width: max-content; max-width: min(17.5rem, 80vw); }\n.p16b-win .hint { font-size: var(--fs-small); }\n.p16b-fade { opacity: 0.5; }\n.p16b-pressed { border-width: var(--w2); border-color: var(--ink); text-decoration: underline; text-underline-offset: 0.25em; }\n\n.dialog.p16b-dlg { max-height: 100%; }\n.dialog__foot.p16b-foot3 { flex-direction: column; }\n.dialog__foot.p16b-foot3 > * { flex: none; }\n.p16b-dlg .dialog__body p + p { color: var(--muted); }\n.p16b-dlg .banner { padding-inline: var(--s-3); }\n.p16b-dlg .dialog__foot .p16b-tipw { position: relative; }\n.p16b-dtip { position: absolute; z-index: 30; bottom: calc(100% + var(--s-1)); right: 0; width: max-content; max-width: min(17.5rem, 80vw); }\n\n.p16b-above { display: contents; }\n.p16b-list { max-height: 11.5rem; overflow: auto; grid-auto-rows: min-content; }\n.p16b-opt { padding-block: var(--s-2); align-items: flex-start; }\n.p16b-opt__txt { display: grid; gap: var(--s-1); min-width: 0; text-align: start; }\n.p16b-opt__sub { font-size: var(--fs-cap); line-height: var(--lh-cap); color: